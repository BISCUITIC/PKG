<Window x:Class="ColorConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ColorConverter"
        Title="Color Converter"
        Width="1000"
        Height="700"
        Background="#F3F4F6">


    <Window.Resources>


        <!-- Стиль карточек -->

        <Style TargetType="GroupBox">

            <Setter Property="Margin"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="15"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>



        <!-- Кнопочный вид заголовков -->

        <Style TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

        </Style>


    </Window.Resources>



    <Grid Margin="30">


        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="150"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- Заголовок -->

        <StackPanel>

            <TextBlock Text="Color Converter"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>


            <TextBlock Text="RGB  ↔  XYZ  ↔  LAB"
                       FontSize="16"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,20"/>

        </StackPanel>





        <!-- Панели моделей -->

        <Grid Grid.Row="1">


            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition/>

                <ColumnDefinition/>

            </Grid.ColumnDefinitions>




            <!-- RGB -->


            <GroupBox Header="RGB"
                      Grid.Column="0"
                      Background="White">


                <StackPanel>


                    <TextBlock Text="Red: 0-255"
                               Foreground="Gray"
                               FontSize="12"/>


                    <controls:ColorComponent
                        DataContext="{Binding RGB.R}"/>



                    <TextBlock Text="Green: 0-255"
                               Foreground="Gray"
                               FontSize="12"/>


                    <controls:ColorComponent
                        DataContext="{Binding RGB.G}"/>



                    <TextBlock Text="Blue: 0-255"
                               Foreground="Gray"
                               FontSize="12"/>


                    <controls:ColorComponent
                        DataContext="{Binding RGB.B}"/>


                </StackPanel>


            </GroupBox>







            <!-- XYZ -->


            <GroupBox Header="XYZ"
                      Grid.Column="1"
                      Background="White">


                <StackPanel>


                    <TextBlock Text="X"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding XYZ.X}"/>



                    <TextBlock Text="Y"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding XYZ.Y}"/>



                    <TextBlock Text="Z"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding XYZ.Z}"/>


                </StackPanel>


            </GroupBox>







            <!-- LAB -->


            <GroupBox Header="LAB"
                      Grid.Column="2"
                      Background="White">


                <StackPanel>


                    <TextBlock Text="Lightness"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding LAB.L}"/>



                    <TextBlock Text="Green-Red axis"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding LAB.A}"/>



                    <TextBlock Text="Blue-Yellow axis"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding LAB.B}"/>


                </StackPanel>


            </GroupBox>



        </Grid>








        <!-- Предпросмотр -->


        <Grid Grid.Row="2" Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="15"
                    Background="{Binding PreviewBrush}"/>

            <Button Grid.Column="1"
        Content="Палитра"
        Click="PickColor_Click"
        Margin="20,0,0,0"
        Padding="22,10"
        MinHeight="46"
        VerticalAlignment="Center"
        FontFamily="Segoe UI"
        FontSize="15"
        FontWeight="SemiBold"
        Foreground="White"
        Background="#4F46E5"
        BorderBrush="Transparent"
        BorderThickness="2"
        Cursor="Hand"
        FocusVisualStyle="{x:Null}"
        ToolTip="Открыть палитру Windows">

                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="12">

                            <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#4338CA"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#3730A3"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="#A5B4FC"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>







        <!-- Предупреждение -->


        <ItemsControl Grid.Row="3"
                      ItemsSource="{Binding Warnings}">

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <TextBlock Text="{Binding}"
                               Foreground="#D97706"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Margin="0,3"/>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>



    </Grid>


</Window>