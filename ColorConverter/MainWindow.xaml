<Window x:Class="ColorConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ColorConverter"
        Title="Color Converter"
        Width="1000"
        Height="700"
        Background="#F3F4F6">


    <Window.Resources>


        <!-- Стиль карточек -->

        <Style TargetType="GroupBox">

            <Setter Property="Margin"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="15"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>



        <!-- Кнопочный вид заголовков -->

        <Style TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

        </Style>


    </Window.Resources>



    <Grid Margin="30">


        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="150"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- Заголовок -->

        <StackPanel>

            <TextBlock Text="Color Converter"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>


            <TextBlock Text="RGB  ↔  XYZ  ↔  LAB"
                       FontSize="16"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,20"/>

        </StackPanel>





        <!-- Панели моделей -->

        <Grid Grid.Row="1">


            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition/>

                <ColumnDefinition/>

            </Grid.ColumnDefinitions>




            <!-- RGB -->


            <GroupBox Header="RGB"
                      Grid.Column="0"
                      Background="White">


                <StackPanel>


                    <TextBlock Text="Red: 0-255"
                               Foreground="Gray"
                               FontSize="12"/>


                    <controls:ColorComponent
                        DataContext="{Binding RGB.R}"/>



                    <TextBlock Text="Green: 0-255"
                               Foreground="Gray"
                               FontSize="12"/>


                    <controls:ColorComponent
                        DataContext="{Binding RGB.G}"/>



                    <TextBlock Text="Blue: 0-255"
                               Foreground="Gray"
                               FontSize="12"/>


                    <controls:ColorComponent
                        DataContext="{Binding RGB.B}"/>


                </StackPanel>


            </GroupBox>







            <!-- XYZ -->


            <GroupBox Header="XYZ"
                      Grid.Column="1"
                      Background="White">


                <StackPanel>


                    <TextBlock Text="X"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding XYZ.X}"/>



                    <TextBlock Text="Y"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding XYZ.Y}"/>



                    <TextBlock Text="Z"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding XYZ.Z}"/>


                </StackPanel>


            </GroupBox>







            <!-- LAB -->


            <GroupBox Header="LAB"
                      Grid.Column="2"
                      Background="White">


                <StackPanel>


                    <TextBlock Text="Lightness"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding LAB.L}"/>



                    <TextBlock Text="Green-Red axis"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding LAB.A}"/>



                    <TextBlock Text="Blue-Yellow axis"
                               Foreground="Gray"/>


                    <controls:ColorComponent
                        DataContext="{Binding LAB.B}"/>


                </StackPanel>


            </GroupBox>



        </Grid>








        <!-- Предпросмотр -->


        <Border Grid.Row="2"
                Margin="20"
                CornerRadius="15"
                Background="{Binding PreviewBrush}">

        </Border>







        <!-- Предупреждение -->


        <ItemsControl Grid.Row="3"
                      ItemsSource="{Binding Warnings}">

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <TextBlock Text="{Binding}"
                               Foreground="#D97706"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Margin="0,3"/>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>



    </Grid>


</Window>