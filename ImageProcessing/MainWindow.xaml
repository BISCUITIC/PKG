<Window x:Class="ImageProcessing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageProcessing"
        mc:Ignorable="d"
        Title="MainWindow"
        Background="{StaticResource WindowBrush}"
        Width="1300" Height="850" MinWidth="1000" MinHeight="700">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                
                <TextBlock 
                    Text="Основы обработки цифровых изображений" 
                    Foreground="{StaticResource TextBrush}"
                    FontSize="28" 
                    FontWeight="Bold" />
                
                <TextBlock 
                    Text="Локальная и адаптивная пороговая обработка · сегментация"                  
                    Foreground="{StaticResource TextSecendoryBrush}" 
                    FontSize="14" />
                
            </StackPanel>
            
            <Border 
                Grid.Column="1" 
                Background="#E8EAFE" 
                CornerRadius="10" 
                Padding="15, 10" 
                VerticalAlignment="Center">
                
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#4F46E5" VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock Text="C# / WPF" Foreground="#3934A5" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
                
            </Border>
        </Grid>


        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Border 
                Grid.Column="0" 
                Background="{StaticResource CardBrush}" 
                BorderBrush="{StaticResource DefaultBorderBrush}"
                BorderThickness="1" 
                CornerRadius="15" 
                Padding="10">
                
                <ScrollViewer 
                    VerticalScrollBarVisibility="Auto" 
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="15">
                    
                    <StackPanel>
                        
                        <TextBlock 
                            Text="Изображение" 
                            FontSize="16" 
                            FontWeight="Bold" 
                            Foreground="{StaticResource TextBrush}" />
                        
                        <TextBlock 
                            Text="Загрузите файл для начала обработки." 
                            FontSize="12" 
                            Foreground="{StaticResource TextSecendoryBrush}" />
                        
                        <Button 
                            x:Name="OpenButton" 
                            Click="OpenButton_Click"
                            Content="Открыть изображениe"                                                        
                            HorizontalAlignment="Stretch"
                            Margin="0,20,0,20"/>
                        
                        <TextBlock 
                            x:Name="FileInfoText" 
                            Text="Файл не выбран" 
                            FontSize="12" 
                            Foreground="{StaticResource TextSecendoryBrush}"
                            TextWrapping="Wrap" />

                        <Border 
                            Height="1" 
                            Background="{StaticResource DefaultBorderBrush}" 
                            Margin="0,20,0,20" />
                        
                        <TextBlock 
                            Text="Метод обработки" 
                            FontSize="16" 
                            FontWeight="Bold" 
                            Foreground="{StaticResource TextBrush}" />
                        
                        <TextBlock 
                            Text="Выберите алгоритм из списка." 
                            FontSize="12" 
                            Foreground="{StaticResource TextSecendoryBrush}" />

                        <ComboBox 
                            x:Name="MethodComboBox"
                            SelectionChanged="MethodComboBox_SelectionChanged"
                            Margin="0,20,0,20">
                            
                            
                            <ComboBoxItem Tag="Niblack" Content="Локальная: Ниблэк (Niblack)" />
                            <ComboBoxItem Tag="Sauvola" Content="Локальная: Саувола (Sauvola)" />
                            <ComboBoxItem Tag="AdaptiveMean" Content="Адаптивная: среднее" />
                            <ComboBoxItem Tag="AdaptiveGaussian" Content="Адаптивная: Гаусс" />
                            <ComboBoxItem Tag="Point" Content="Сегментация: точки" />
                            <ComboBoxItem Tag="HorizontalLine" Content="Сегментация: горизонтальные линии" />
                            <ComboBoxItem Tag="VerticalLine" Content="Сегментация: вертикальные линии" />
                            <ComboBoxItem Tag="DiagonalDownLine" Content="Сегментация: диагональ ↘" />
                            <ComboBoxItem Tag="DiagonalUpLine" Content="Сегментация: диагональ ↙" />
                            <ComboBoxItem Tag="Sobel" Content="Сегментация: границы (Sobel)" />
                            
                        </ComboBox>
                        
                        
                        <TextBlock 
                            Text="Размер локального окна" 
                            FontSize="14" 
                            FontWeight="Bold" 
                            Foreground="{StaticResource TextBrush}" />

                        <Grid Margin="0,5,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock 
                                Grid.Column="0" 
                                Text="Нечётное число, от 3 до 101" 
                                FontSize="12"
                                Foreground="{StaticResource TextSecendoryBrush}" 
                                VerticalAlignment="Center" />
                            
                            <TextBox 
                                Grid.Column="1" 
                                x:Name="WindowSizeBox" 
                                Text="15" 
                                HorizontalContentAlignment="Center" />
                            
                        </Grid>
                        
                        
                        <TextBlock 
                            x:Name="ParameterLabel" 
                            Text="K (коэффициент)" 
                            FontSize="14" 
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"/>
                                                
                        <Grid Margin="0,5,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>

                            <TextBlock 
                                Grid.Column="0"
                                Text="Параметр зависит от выбранного метода." 
                                FontSize="11"
                                Foreground="{StaticResource TextSecendoryBrush}"
                                TextWrapping="Wrap" />

                            <TextBox 
                                Grid.Column="1"
                                x:Name="ParameterBox" 
                                Text="-0.2" 
                                HorizontalContentAlignment="Center"/>
                        </Grid>


                        <Border 
                            Height="1" 
                            Background="{StaticResource DefaultBorderBrush}" 
                            Margin="0,20,0,20" />

                        <Button 
                            x:Name="ApplyButton" 
                            Click="ApplyButton_Click"
                            Content="Применить обработку" 
                            HorizontalAlignment="Stretch" 
                            IsEnabled="False"
                            Margin="0,0,0,10" />


                        <Button 
                            x:Name="SaveButton" 
                            Click="SaveButton_Click"
                            Content="Сохранить результат (PNG)"                             
                            HorizontalAlignment="Stretch" 
                            IsEnabled="False" 
                            Margin="0,10,0,0" />

                        <Border 
                            Height="1" 
                            Background="{StaticResource DefaultBorderBrush}" 
                            Margin="0,20,0,20" />
                                                
                        <TextBlock 
                            Text="Как работает метод" 
                            FontSize="14" 
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}" />
                        
                        <TextBlock 
                            x:Name="MethodDescription" 
                            TextWrapping="Wrap" 
                            FontSize="12" 
                            LineHeight="18"
                            Foreground="{StaticResource TextSecendoryBrush}" />
                        
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <Grid Grid.Column="2">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel 
                        Grid.Column="0"
                        Margin="0,0,0,10">
                        <TextBlock 
                            Text="Исходное изображение" 
                            FontSize="14" 
                            FontWeight="Bold" 
                            Foreground="{StaticResource TextBrush}" />

                        <TextBlock 
                            Text="Цветной оригинал" 
                            FontSize="12" 
                            Foreground="{StaticResource TextSecendoryBrush}"  />
                    </StackPanel>

                    <StackPanel 
                        Grid.Column="2" 
                        Margin="0,0,0,10">
                        <TextBlock 
                            Text="Результат обработки" 
                            FontSize="14" 
                            FontWeight="Bold" 
                            Foreground="{StaticResource TextBrush}" />

                        <TextBlock 
                            Text="Отображение в градациях серого" 
                            FontSize="12" 
                            Foreground="{StaticResource TextSecendoryBrush}"  />
                    </StackPanel>
                    
                </Grid>
                
                <Grid Grid.Row="1">
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Border 
                        Grid.Column="0" 
                        Background="#202633" 
                        BorderBrush="{StaticResource DefaultBorderBrush}"
                        BorderThickness="1" 
                        CornerRadius="15" 
                        ClipToBounds="True">
                        
                        <Grid>
                            <TextBlock 
                                x:Name="OriginalPlaceholder" 
                                Text="Загрузите изображение&#10;(PNG, JPEG, BMP, TIFF)"
                                TextAlignment="Center" 
                                TextWrapping="Wrap" 
                                Foreground="#AAB3C5"
                                FontSize="14" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" />
                            
                            <Image x:Name="OriginalImage" Stretch="Uniform" Margin="8" />
                        </Grid>
                    </Border>
                    
                    <Border 
                        Grid.Column="2" 
                        Background="#202633" 
                        BorderBrush="{StaticResource DefaultBorderBrush}"
                        BorderThickness="1" 
                        CornerRadius="12" 
                        ClipToBounds="True">
                        
                        <Grid>
                            <TextBlock 
                                x:Name="ResultPlaceholder" 
                                Text="Результат появится&#10;после применения метода"
                                TextAlignment="Center" 
                                TextWrapping="Wrap" 
                                Foreground="#AAB3C5"
                                FontSize="14" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" />
                            
                            <Image x:Name="ResultImage" Stretch="Uniform" Margin="8" />
                        </Grid>
                    </Border>
                    
                </Grid>
            </Grid>
        
        </Grid>
            
        
        <Border 
            Grid.Row="2" 
            Background="{StaticResource CardBrush}" 
            CornerRadius="8" 
            Padding="15,10" 
            Margin="0,10,0,0">
            
            <DockPanel LastChildFill="True">
                <TextBlock 
                    Text="СТАТУС" 
                    FontSize="12" 
                    FontWeight="Bold" 
                    Foreground="{StaticResource AccentBrush}" 
                    DockPanel.Dock="Left" 
                    Margin="0,0,10,0" 
                    VerticalAlignment="Center" />
                
                <TextBlock 
                    x:Name="StatusText" 
                    Text="Готово к работе. Откройте изображение." 
                    FontSize="12" 
                    Foreground="{StaticResource TextBrush}" 
                    TextTrimming="CharacterEllipsis" />
                
            </DockPanel>
        </Border>     
        
    
    </Grid>
</Window>
