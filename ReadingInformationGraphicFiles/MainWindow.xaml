<Window x:Class="ReadingInformationGraphicFiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Лабораторная работа №2 — Информация об изображениях"
        Height="760"
        Width="1220"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Анализ растровых изображений"
                   FontSize="23"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FolderTextBox"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     ToolTip="Укажите папку с изображениями" />

            <CheckBox x:Name="RecursiveCheckBox"
                      Grid.Column="1"
                      Content="Включая подпапки"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      Margin="12,0,8,0" />

            <Button x:Name="BrowseButton"
                    Grid.Column="2"
                    Content="Обзор..."
                    Padding="12,7"
                    Margin="4,0,0,0"
                    MinWidth="90"
                    Click="Browse_Click" />

            <Button x:Name="StartButton"
                    Grid.Column="3"
                    Content="Сканировать"
                    Padding="12,7"
                    Margin="4,0,0,0"
                    MinWidth="100"
                    Click="Start_Click" />

            <Button x:Name="CancelButton"
                    Grid.Column="4"
                    Content="Остановить"
                    Padding="12,7"
                    Margin="4,0,0,0"
                    MinWidth="100"
                    IsEnabled="False"
                    Click="Cancel_Click" />
        </Grid>

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding FullPath}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="ToolTip" Value="{Binding Error}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя файла" Binding="{Binding FileName}" Width="300" />
                <DataGridTextColumn Header="Формат" Binding="{Binding Format}" Width="90" />
                <DataGridTextColumn Header="Размер, px" Binding="{Binding Dimensions}" Width="130" />
                <DataGridTextColumn Header="Разрешение, dpi" Binding="{Binding Resolution}" Width="150" />
                <DataGridTextColumn Header="Глубина цвета" Binding="{Binding ColorDepth}" Width="150" />
                <DataGridTextColumn Header="Сжатие" Binding="{Binding Compression}" Width="180" />
                <DataGridTextColumn Header="Размер файла" Binding="{Binding FileSize}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Text="Выберите папку и нажмите «Сканировать»."
                       VerticalAlignment="Center" />

            <ProgressBar x:Name="ProgressBar"
                         Grid.Column="1"
                         Width="220"
                         Height="16"
                         Margin="12,0,0,0"
                         Minimum="0"
                         Maximum="1" />
        </Grid>

        <Expander Grid.Row="4"
                  Header="Что означают столбцы"
                  IsExpanded="False"
                  Margin="0,10,0,0">
            <TextBlock Margin="4,6,4,2"
                       TextWrapping="Wrap"
                       Text="Размер, px — ширина и высота изображения в пикселях.&#10;Разрешение, dpi — количество пикселей на дюйм; берётся из метаданных или заголовка формата.&#10;Глубина цвета — число бит, используемых для хранения цвета одного пикселя или индекса палитры.&#10;Сжатие — способ кодирования данных изображения внутри формата.&#10;Файлы анализируются по заголовкам и метаданным, поэтому полный растровый массив в память не загружается." />
        </Expander>
    </Grid>
</Window>
